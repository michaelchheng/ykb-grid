rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────────
    // Anyone can read (leaderboard), only the owner can write their own data
    match /users/{userId} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Per-tier game data — same rules as parent
      match /tiers/{tier} {
        allow read:  if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Leaderboard (aggregated, server-written only) ───────────────────────
    match /leaderboard/{entry} {
      allow read: if true;
      allow write: if false; // only written by Cloud Functions / server
    }

    // ── Gauntlet feedback (authenticated users only) ────────────────────────
    match /gauntletFeedback/{doc} {
      allow read:  if false; // server-only analytics
      allow write: if request.auth != null;
    }

    // ── Agent pipeline logs (server-only via Admin SDK) ────────────────────
    match /agentLogs/{doc} {
      allow read:  if false;
      allow write: if false; // Admin SDK bypasses these rules
    }

  }
}
